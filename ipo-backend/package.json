{
  "name": "ipo-pos-backend",
  "version": "1.0.0",
  "description": "Backend iPo Mie Pangsit (POS Kasir + integrasi GoFood) - Express + PostgreSQL (Neon), siap deploy di Vercel",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
